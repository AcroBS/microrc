rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isNumberInRange(val, minVal, maxVal) {
      return (val is int || val is float) && val >= minVal && val <= maxVal;
    }

    function isValidTimestampBound(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // --- Validation Blueprints ---

    function isValidOnlineRoom(data) {
      return data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128 &&
             data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 24 &&
             data.roomName is string && data.roomName.size() >= 1 && data.roomName.size() <= 40 &&
             data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 12 &&
             data.discoverable is bool &&
             data.passwordProtected is bool &&
             data.passwordSalt is string && data.passwordSalt.size() <= 32 &&
             data.passwordHash is string && data.passwordHash.size() <= 64 &&
             (!data.passwordProtected || (data.passwordSalt.size() >= 8 && data.passwordHash.size() == 64)) &&
             (data.passwordProtected || data.passwordHash.size() == 0) &&
             data.status is string && data.status in ['OPEN', 'RACING', 'FINISHED'] &&
             data.gameMode is string && data.gameMode in ['RACE', 'ARENA', 'STUNTS', 'HYBRID'] &&
             data.trackId is string && data.trackId.size() >= 1 && data.trackId.size() <= 64 &&
             data.playerCount is int && data.playerCount >= 1 && data.playerCount <= 4 &&
             data.maxPlayers is int && data.maxPlayers >= 2 && data.maxPlayers <= 4 &&
             data.playerCount <= data.maxPlayers &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 4 &&
             data.memberUids[0] is string && data.memberUids[0].size() <= 128 &&
             data.lobbyJson is string && data.lobbyJson.size() >= 2 && data.lobbyJson.size() <= 30000 &&
             data.raceStartJson is string && data.raceStartJson.size() <= 40000 &&
             data.telemetrySeq is int && data.telemetrySeq >= 0 &&
             data.telemetryLine is string && data.telemetryLine.size() <= 16000 &&
             data.rematchJson is string && data.rematchJson.size() <= 8000 &&
             isValidTimestampBound(data.createdAt) &&
             isValidTimestampBound(data.updatedAt);
    }

    function isValidOnlineRoomPlayer(data) {
      return data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 128 &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 24 &&
             data.carType is string && data.carType.size() >= 1 && data.carType.size() <= 32 &&
             data.primaryColorArgb is int &&
             data.accentColorArgb is int &&
             data.ready is bool &&
             data.host is bool &&
             data.rematchVote is string && data.rematchVote.size() <= 64 &&
             data.joinToken is string && data.joinToken.size() <= 64 &&
             (!('equippedUpgradesMask' in data) || (data.equippedUpgradesMask is int && data.equippedUpgradesMask >= 0 && data.equippedUpgradesMask <= 127)) &&
             isValidTimestampBound(data.createdAt) &&
             isValidTimestampBound(data.updatedAt);
    }

    function isValidOnlineRoomInput(data) {
      return data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 128 &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.seq is int && data.seq >= 0 &&
             isNumberInRange(data.throttle, -1.0, 1.0) &&
             isNumberInRange(data.steer, -1.0, 1.0) &&
             data.powerUpSeq is int && data.powerUpSeq >= 0 &&
             data.mineDropSeq is int && data.mineDropSeq >= 0 &&
             isValidTimestampBound(data.createdAt) &&
             isValidTimestampBound(data.updatedAt);
    }

    function isValidOnlineRoomChat(data) {
      return data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 128 &&
             data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 24 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 140 &&
             data.systemMessage is bool &&
             isValidTimestampBound(data.createdAt);
    }

    function isValidLeaderboardEntry(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.driverName is string && data.driverName.size() >= 1 && data.driverName.size() <= 24 &&
             data.carType is string && data.carType.size() >= 1 && data.carType.size() <= 32 &&
             data.primaryColorArgb is int &&
             data.accentColorArgb is int &&
             data.gameMode is string && data.gameMode in ['RACE', 'STUNTS', 'ARENA'] &&
             data.trackKey is string && data.trackKey.size() >= 1 && data.trackKey.size() <= 64 &&
             data.boardKey is string && data.boardKey.size() >= 3 && data.boardKey.size() <= 96 &&
             data.totalLaps is int && data.totalLaps >= 1 && data.totalLaps <= 9 &&
             data.bestRaceTimeMs is int && data.bestRaceTimeMs >= 0 && data.bestRaceTimeMs <= 3600000 &&
             data.bestLapTimeMs is int && data.bestLapTimeMs >= 0 && data.bestLapTimeMs <= 3600000 &&
             data.bestScore is int && data.bestScore >= 0 && data.bestScore <= 1000000 &&
             data.hasGhost is bool &&
             data.ghostId is string && data.ghostId.size() <= 128 &&
             data.publicEntry is bool &&
             (!('equippedUpgradesMask' in data) || (data.equippedUpgradesMask is int && data.equippedUpgradesMask >= 0 && data.equippedUpgradesMask <= 127)) &&
             isValidTimestampBound(data.createdAt) &&
             isValidTimestampBound(data.updatedAt);
    }

    function isValidGhostRun(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.driverName is string && data.driverName.size() >= 1 && data.driverName.size() <= 24 &&
             data.carType is string && data.carType.size() >= 1 && data.carType.size() <= 32 &&
             data.primaryColorArgb is int &&
             data.accentColorArgb is int &&
             data.boardKey is string && data.boardKey.size() >= 3 && data.boardKey.size() <= 96 &&
             data.trackId is string && data.trackId.size() >= 1 && data.trackId.size() <= 64 &&
             data.totalLaps is int && data.totalLaps >= 1 && data.totalLaps <= 9 &&
             data.finishTimeMs is int && data.finishTimeMs >= 1 && data.finishTimeMs <= 3600000 &&
             data.bestLapMs is int && data.bestLapMs >= 0 && data.bestLapMs <= 3600000 &&
             data.framesData is string && data.framesData.size() >= 3 && data.framesData.size() <= 120000 &&
             data.publicGhost is bool &&
             (!('equippedUpgradesMask' in data) || (data.equippedUpgradesMask is int && data.equippedUpgradesMask >= 0 && data.equippedUpgradesMask <= 127)) &&
             isValidTimestampBound(data.createdAt) &&
             isValidTimestampBound(data.updatedAt);
    }

    function isValidDriverProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.driverName is string && data.driverName.size() >= 1 && data.driverName.size() <= 24 &&
             data.searchName is string && data.searchName.size() >= 1 && data.searchName.size() <= 24 &&
             data.friendCode is string && data.friendCode.size() >= 4 && data.friendCode.size() <= 12 &&
             data.friendCode.matches('^[A-Z0-9]+$') &&
             data.carType is string && data.carType.size() >= 1 && data.carType.size() <= 32 &&
             data.primaryColorArgb is int &&
             data.accentColorArgb is int &&
             data.online is bool &&
             data.activityStatus is string && data.activityStatus in ['ONLINE', 'IN_LOBBY', 'RACING', 'OFFLINE'] &&
             data.activeRoomId is string && data.activeRoomId.size() <= 128 &&
             data.activeRoomCode is string && data.activeRoomCode.size() <= 12 &&
             data.activeRoomName is string && data.activeRoomName.size() <= 40 &&
             data.publicProfile is bool &&
             (!('equippedUpgradesMask' in data) || (data.equippedUpgradesMask is int && data.equippedUpgradesMask >= 0 && data.equippedUpgradesMask <= 127)) &&
             (!('carVisualsJson' in data) || (data.carVisualsJson is string && data.carVisualsJson.size() <= 2048)) &&
             isValidTimestampBound(data.lastSeenAt) &&
             isValidTimestampBound(data.createdAt) &&
             isValidTimestampBound(data.updatedAt);
    }

    function isValidFriendship(data) {
      return data.memberUids is list && data.memberUids.size() == 2 &&
             data.memberUids[0] is string && data.memberUids[0].size() >= 1 && data.memberUids[0].size() <= 128 &&
             data.memberUids[1] is string && data.memberUids[1].size() >= 1 && data.memberUids[1].size() <= 128 &&
             data.requesterUid is string && data.requesterUid.size() >= 1 && data.requesterUid.size() <= 128 &&
             data.receiverUid is string && data.receiverUid.size() >= 1 && data.receiverUid.size() <= 128 &&
             data.requesterUid != data.receiverUid &&
             data.requesterUid in data.memberUids &&
             data.receiverUid in data.memberUids &&
             data.requesterName is string && data.requesterName.size() >= 1 && data.requesterName.size() <= 24 &&
             data.requesterFriendCode is string && data.requesterFriendCode.size() >= 4 && data.requesterFriendCode.size() <= 12 &&
             data.receiverName is string && data.receiverName.size() >= 1 && data.receiverName.size() <= 24 &&
             data.receiverFriendCode is string && data.receiverFriendCode.size() >= 4 && data.receiverFriendCode.size() <= 12 &&
             data.status is string && data.status in ['PENDING', 'ACCEPTED'] &&
             isValidTimestampBound(data.createdAt) &&
             isValidTimestampBound(data.updatedAt);
    }

    function isValidSessionInvite(data) {
      return data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 24 &&
             data.senderCarType is string && data.senderCarType.size() >= 1 && data.senderCarType.size() <= 32 &&
             data.senderColorArgb is int &&
             data.recipientUid is string && data.recipientUid.size() >= 1 && data.recipientUid.size() <= 128 &&
             data.senderUid != data.recipientUid &&
             data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 24 &&
             data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 128 &&
             data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 12 &&
             data.roomName is string && data.roomName.size() >= 1 && data.roomName.size() <= 40 &&
             data.gameMode is string && data.gameMode in ['RACE', 'ARENA', 'STUNTS', 'HYBRID'] &&
             data.joinToken is string && data.joinToken.size() <= 64 &&
             data.status is string && data.status in ['PENDING', 'ACCEPTED', 'DECLINED', 'EXPIRED'] &&
             isValidTimestampBound(data.createdAt) &&
             isValidTimestampBound(data.updatedAt);
    }

    function isValidLeaderboardNotification(data) {
      return data.friendshipId is string && data.friendshipId.size() >= 3 && data.friendshipId.size() <= 128 &&
             data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 24 &&
             data.senderCarType is string && data.senderCarType.size() >= 1 && data.senderCarType.size() <= 32 &&
             data.senderColorArgb is int &&
             data.recipientUid is string && data.recipientUid.size() >= 1 && data.recipientUid.size() <= 128 &&
             data.senderUid != data.recipientUid &&
             data.gameMode is string && data.gameMode in ['RACE', 'STUNTS', 'ARENA'] &&
             data.trackKey is string && data.trackKey.size() >= 1 && data.trackKey.size() <= 64 &&
             data.trackName is string && data.trackName.size() >= 1 && data.trackName.size() <= 48 &&
             data.boardKey is string && data.boardKey.size() >= 3 && data.boardKey.size() <= 96 &&
             data.totalLaps is int && data.totalLaps >= 1 && data.totalLaps <= 9 &&
             data.bestRaceTimeMs is int && data.bestRaceTimeMs >= 0 && data.bestRaceTimeMs <= 3600000 &&
             data.bestScore is int && data.bestScore >= 0 && data.bestScore <= 1000000 &&
             data.dailyChallenge is bool &&
             data.status is string && data.status in ['UNREAD', 'DISMISSED'] &&
             isValidTimestampBound(data.createdAt) &&
             isValidTimestampBound(data.updatedAt);
    }

    function isValidCustomTrack(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 24 &&
             data.trackName is string && data.trackName.size() >= 1 && data.trackName.size() <= 32 &&
             data.themeId is string && data.themeId in ['LIVING_ROOM_GP', 'BACKYARD_DIRT', 'NEON_ROOFTOP', 'SANDBOX_DUNES', 'WAREHOUSE_DRIFT'] &&
             isNumberInRange(data.roadHalfWidth, 80.0, 150.0) &&
             data.payloadData is string && data.payloadData.size() >= 10 && data.payloadData.size() <= 25000 &&
             data.publicTrack is bool &&
             isValidTimestampBound(data.createdAt) &&
             isValidTimestampBound(data.updatedAt);
    }

    // --- 1. Online Multiplayer Rooms (/onlineRooms/{roomId}) ---
    match /onlineRooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId);
      allow list: if isSignedIn() && existing().discoverable == true;

      allow create: if isSignedIn() &&
                       isValidId(roomId) &&
                       incoming().keys().hasAll([
                         'hostUid', 'hostName', 'roomName', 'roomCode', 'discoverable',
                         'passwordProtected', 'passwordSalt', 'passwordHash', 'status',
                         'gameMode', 'trackId', 'playerCount', 'maxPlayers', 'memberUids',
                         'lobbyJson', 'raceStartJson', 'telemetrySeq', 'telemetryLine',
                         'rematchJson', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'hostUid', 'hostName', 'roomName', 'roomCode', 'discoverable',
                         'passwordProtected', 'passwordSalt', 'passwordHash', 'status',
                         'gameMode', 'trackId', 'playerCount', 'maxPlayers', 'memberUids',
                         'lobbyJson', 'raceStartJson', 'telemetrySeq', 'telemetryLine',
                         'rematchJson', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().hostUid == request.auth.uid &&
                       incoming().status == 'OPEN' &&
                       isValidOnlineRoom(incoming());

      allow update: if isSignedIn() &&
                       isValidId(roomId) &&
                       isValidOnlineRoom(incoming()) &&
                       existing().hostUid == request.auth.uid &&
                       incoming().hostUid == existing().hostUid &&
                       incoming().roomCode == existing().roomCode &&
                       incoming().passwordProtected == existing().passwordProtected &&
                       incoming().passwordSalt == existing().passwordSalt &&
                       incoming().passwordHash == existing().passwordHash &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'hostName', 'roomName', 'discoverable', 'status', 'gameMode',
                         'trackId', 'playerCount', 'maxPlayers', 'memberUids',
                         'lobbyJson', 'raceStartJson', 'telemetrySeq', 'telemetryLine',
                         'rematchJson', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(roomId) && existing().hostUid == request.auth.uid;

      // --- 1a. Online Room Players (/onlineRooms/{roomId}/players/{playerId}) ---
      match /players/{playerId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(playerId) && (resource == null || existing().roomId == roomId);
        allow list: if isSignedIn() && isValidId(roomId) && existing().roomId == roomId;

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(playerId) &&
                         request.auth.uid == playerId &&
                         incoming().keys().hasAll([
                           'roomId', 'userId', 'name', 'carType', 'primaryColorArgb',
                           'accentColorArgb', 'ready', 'host', 'rematchVote', 'joinToken',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'roomId', 'userId', 'name', 'carType', 'primaryColorArgb',
                           'accentColorArgb', 'equippedUpgradesMask', 'ready', 'host',
                           'rematchVote', 'joinToken', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().roomId == roomId &&
                         incoming().userId == request.auth.uid &&
                         isValidOnlineRoomPlayer(incoming()) &&
                         exists(/databases/$(database)/documents/onlineRooms/$(roomId)) &&
                         (
                           (
                             incoming().host == true &&
                             get(/databases/$(database)/documents/onlineRooms/$(roomId)).data.hostUid == request.auth.uid
                           ) ||
                           (
                             incoming().host == false &&
                             get(/databases/$(database)/documents/onlineRooms/$(roomId)).data.status == 'OPEN' &&
                             get(/databases/$(database)/documents/onlineRooms/$(roomId)).data.playerCount < get(/databases/$(database)/documents/onlineRooms/$(roomId)).data.maxPlayers &&
                             (
                               !get(/databases/$(database)/documents/onlineRooms/$(roomId)).data.passwordProtected ||
                               incoming().joinToken == get(/databases/$(database)/documents/onlineRooms/$(roomId)).data.passwordHash
                             )
                           )
                         );

        allow update: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(playerId) &&
                         isValidOnlineRoomPlayer(incoming()) &&
                         request.auth.uid == playerId &&
                         existing().userId == request.auth.uid &&
                         incoming().userId == existing().userId &&
                         incoming().roomId == existing().roomId &&
                         incoming().host == existing().host &&
                         incoming().joinToken == existing().joinToken &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'name', 'carType', 'primaryColorArgb', 'accentColorArgb',
                           'equippedUpgradesMask', 'ready', 'rematchVote', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(playerId) &&
                         (
                           request.auth.uid == playerId ||
                           (
                             exists(/databases/$(database)/documents/onlineRooms/$(roomId)) &&
                             get(/databases/$(database)/documents/onlineRooms/$(roomId)).data.hostUid == request.auth.uid
                           )
                         );
      }

      // --- 1b. Online Room Driver Inputs (/onlineRooms/{roomId}/inputs/{playerId}) ---
      match /inputs/{playerId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(playerId) && (resource == null || existing().roomId == roomId);
        allow list: if isSignedIn() && isValidId(roomId) && existing().roomId == roomId;

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(playerId) &&
                         request.auth.uid == playerId &&
                         incoming().keys().hasAll([
                           'roomId', 'userId', 'seq', 'throttle', 'steer',
                           'powerUpSeq', 'mineDropSeq', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'roomId', 'userId', 'seq', 'throttle', 'steer',
                           'powerUpSeq', 'mineDropSeq', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().roomId == roomId &&
                         incoming().userId == request.auth.uid &&
                         isValidOnlineRoomInput(incoming()) &&
                         exists(/databases/$(database)/documents/onlineRooms/$(roomId)/players/$(request.auth.uid));

        allow update: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(playerId) &&
                         isValidOnlineRoomInput(incoming()) &&
                         request.auth.uid == playerId &&
                         existing().userId == request.auth.uid &&
                         incoming().userId == existing().userId &&
                         incoming().roomId == existing().roomId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'seq', 'throttle', 'steer', 'powerUpSeq', 'mineDropSeq', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(playerId) &&
                         (
                           request.auth.uid == playerId ||
                           (
                             exists(/databases/$(database)/documents/onlineRooms/$(roomId)) &&
                             get(/databases/$(database)/documents/onlineRooms/$(roomId)).data.hostUid == request.auth.uid
                           )
                         );
      }

      // --- 1c. Online Room Chat (/onlineRooms/{roomId}/chat/{messageId}) ---
      match /chat/{messageId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(messageId) && (resource == null || existing().roomId == roomId);
        allow list: if isSignedIn() && isValidId(roomId) && existing().roomId == roomId;

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         incoming().keys().hasAll([
                           'roomId', 'senderUid', 'senderName', 'text', 'systemMessage', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'roomId', 'senderUid', 'senderName', 'text', 'systemMessage', 'createdAt'
                         ]) &&
                         incoming().roomId == roomId &&
                         incoming().senderUid == request.auth.uid &&
                         isValidOnlineRoomChat(incoming()) &&
                         exists(/databases/$(database)/documents/onlineRooms/$(roomId)/players/$(request.auth.uid));

        allow update: if false;

        allow delete: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         (
                           existing().senderUid == request.auth.uid ||
                           (
                             exists(/databases/$(database)/documents/onlineRooms/$(roomId)) &&
                             get(/databases/$(database)/documents/onlineRooms/$(roomId)).data.hostUid == request.auth.uid
                           )
                         );
      }
    }

    // --- 2. Leaderboards (/leaderboardEntries/{entryId}) ---
    match /leaderboardEntries/{entryId} {
      allow get: if isSignedIn() && isValidId(entryId) && (resource == null || existing().publicEntry == true || existing().userId == request.auth.uid);
      allow list: if isSignedIn() && existing().publicEntry == true;

      allow create: if isSignedIn() &&
                       isValidId(entryId) &&
                       incoming().keys().hasAll([
                         'userId', 'driverName', 'carType', 'primaryColorArgb', 'accentColorArgb',
                         'gameMode', 'trackKey', 'boardKey', 'totalLaps', 'bestRaceTimeMs',
                         'bestLapTimeMs', 'bestScore', 'hasGhost', 'ghostId', 'publicEntry',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'driverName', 'carType', 'primaryColorArgb', 'accentColorArgb',
                         'equippedUpgradesMask', 'gameMode', 'trackKey', 'boardKey', 'totalLaps',
                         'bestRaceTimeMs', 'bestLapTimeMs', 'bestScore', 'hasGhost', 'ghostId',
                         'publicEntry', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().userId == request.auth.uid &&
                       isValidLeaderboardEntry(incoming());

      allow update: if isSignedIn() &&
                       isValidId(entryId) &&
                       isValidLeaderboardEntry(incoming()) &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().boardKey == existing().boardKey &&
                       incoming().gameMode == existing().gameMode &&
                       incoming().trackKey == existing().trackKey &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'driverName', 'carType', 'primaryColorArgb', 'accentColorArgb',
                         'equippedUpgradesMask', 'totalLaps', 'bestRaceTimeMs', 'bestLapTimeMs',
                         'bestScore', 'hasGhost', 'ghostId', 'publicEntry', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(entryId) && existing().userId == request.auth.uid;
    }

    // --- 3. Ghost Car Trajectory Runs (/ghostRuns/{ghostId}) ---
    match /ghostRuns/{ghostId} {
      allow get: if isSignedIn() && isValidId(ghostId) && (resource == null || existing().publicGhost == true || existing().userId == request.auth.uid);
      allow list: if isSignedIn() && existing().publicGhost == true;

      allow create: if isSignedIn() &&
                       isValidId(ghostId) &&
                       incoming().keys().hasAll([
                         'userId', 'driverName', 'carType', 'primaryColorArgb', 'accentColorArgb',
                         'boardKey', 'trackId', 'totalLaps', 'finishTimeMs', 'bestLapMs',
                         'framesData', 'publicGhost', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'driverName', 'carType', 'primaryColorArgb', 'accentColorArgb',
                         'equippedUpgradesMask', 'boardKey', 'trackId', 'totalLaps', 'finishTimeMs',
                         'bestLapMs', 'framesData', 'publicGhost', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().userId == request.auth.uid &&
                       isValidGhostRun(incoming());

      allow update: if isSignedIn() &&
                       isValidId(ghostId) &&
                       isValidGhostRun(incoming()) &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().boardKey == existing().boardKey &&
                       incoming().trackId == existing().trackId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'driverName', 'carType', 'primaryColorArgb', 'accentColorArgb',
                         'equippedUpgradesMask', 'totalLaps', 'finishTimeMs', 'bestLapMs',
                         'framesData', 'publicGhost', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(ghostId) && existing().userId == request.auth.uid;
    }

    // --- 4. Driver Directory & Real-Time Online Presence (/driverProfiles/{userId}) ---
    match /driverProfiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || (resource != null && existing().publicProfile == true));
      allow list: if isSignedIn() && existing().publicProfile == true;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'userId', 'driverName', 'searchName', 'friendCode', 'carType',
                         'primaryColorArgb', 'accentColorArgb', 'online', 'activityStatus',
                         'activeRoomId', 'activeRoomCode', 'activeRoomName', 'publicProfile',
                         'lastSeenAt', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'driverName', 'searchName', 'friendCode', 'carType',
                         'primaryColorArgb', 'accentColorArgb', 'equippedUpgradesMask',
                         'carVisualsJson', 'online', 'activityStatus', 'activeRoomId',
                         'activeRoomCode', 'activeRoomName', 'publicProfile',
                         'lastSeenAt', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().userId == request.auth.uid &&
                       isValidDriverProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidDriverProfile(incoming()) &&
                       request.auth.uid == userId &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().friendCode == existing().friendCode &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'driverName', 'searchName', 'carType', 'primaryColorArgb',
                         'accentColorArgb', 'equippedUpgradesMask', 'carVisualsJson',
                         'online', 'activityStatus', 'activeRoomId',
                         'activeRoomCode', 'activeRoomName', 'publicProfile',
                         'lastSeenAt', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // --- 5. Friendships & Pending Requests (/friendships/{friendshipId}) ---
    match /friendships/{friendshipId} {
      allow get: if isSignedIn() && isValidId(friendshipId) && request.auth.uid in existing().memberUids;
      allow list: if isSignedIn() && request.auth.uid in existing().memberUids;

      allow create: if isSignedIn() &&
                       isValidId(friendshipId) &&
                       incoming().keys().hasAll([
                         'memberUids', 'requesterUid', 'requesterName', 'requesterFriendCode',
                         'receiverUid', 'receiverName', 'receiverFriendCode', 'status',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'memberUids', 'requesterUid', 'requesterName', 'requesterFriendCode',
                         'receiverUid', 'receiverName', 'receiverFriendCode', 'status',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().requesterUid == request.auth.uid &&
                       incoming().status == 'PENDING' &&
                       isValidFriendship(incoming()) &&
                       exists(/databases/$(database)/documents/driverProfiles/$(incoming().receiverUid));

      allow update: if isSignedIn() &&
                       isValidId(friendshipId) &&
                       isValidFriendship(incoming()) &&
                       incoming().memberUids == existing().memberUids &&
                       incoming().requesterUid == existing().requesterUid &&
                       incoming().receiverUid == existing().receiverUid &&
                       incoming().requesterFriendCode == existing().requesterFriendCode &&
                       incoming().receiverFriendCode == existing().receiverFriendCode &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Action 1: Receiver accepts pending friend request
                         (
                           existing().status == 'PENDING' &&
                           existing().receiverUid == request.auth.uid &&
                           incoming().status == 'ACCEPTED' &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'receiverName', 'updatedAt'])
                         ) ||
                         // Action 2: Accepted requester refreshes display callsign
                         (
                           existing().status == 'ACCEPTED' &&
                           incoming().status == 'ACCEPTED' &&
                           existing().requesterUid == request.auth.uid &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['requesterName', 'updatedAt'])
                         ) ||
                         // Action 3: Accepted receiver refreshes display callsign
                         (
                           existing().status == 'ACCEPTED' &&
                           incoming().status == 'ACCEPTED' &&
                           existing().receiverUid == request.auth.uid &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['receiverName', 'updatedAt'])
                         )
                       );

      allow delete: if isSignedIn() && isValidId(friendshipId) && request.auth.uid in existing().memberUids;
    }

    // --- 6. Friend Session Invites / Notifications (/sessionInvites/{inviteId}) ---
    match /sessionInvites/{inviteId} {
      allow get: if isSignedIn() &&
                    isValidId(inviteId) &&
                    (existing().recipientUid == request.auth.uid || existing().senderUid == request.auth.uid);

      allow list: if isSignedIn() &&
                     (existing().recipientUid == request.auth.uid || existing().senderUid == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(inviteId) &&
                       incoming().keys().hasAll([
                         'senderUid', 'senderName', 'senderCarType', 'senderColorArgb',
                         'recipientUid', 'recipientName', 'roomId', 'roomCode', 'roomName',
                         'gameMode', 'joinToken', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'senderUid', 'senderName', 'senderCarType', 'senderColorArgb',
                         'recipientUid', 'recipientName', 'roomId', 'roomCode', 'roomName',
                         'gameMode', 'joinToken', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().senderUid == request.auth.uid &&
                       incoming().status == 'PENDING' &&
                       isValidSessionInvite(incoming()) &&
                       exists(/databases/$(database)/documents/onlineRooms/$(incoming().roomId)) &&
                       exists(/databases/$(database)/documents/onlineRooms/$(incoming().roomId)/players/$(request.auth.uid));

      allow update: if isSignedIn() &&
                       isValidId(inviteId) &&
                       isValidSessionInvite(incoming()) &&
                       existing().status == 'PENDING' &&
                       incoming().senderUid == existing().senderUid &&
                       incoming().senderName == existing().senderName &&
                       incoming().senderCarType == existing().senderCarType &&
                       incoming().senderColorArgb == existing().senderColorArgb &&
                       incoming().recipientUid == existing().recipientUid &&
                       incoming().recipientName == existing().recipientName &&
                       incoming().roomId == existing().roomId &&
                       incoming().roomCode == existing().roomCode &&
                       incoming().roomName == existing().roomName &&
                       incoming().gameMode == existing().gameMode &&
                       incoming().joinToken == existing().joinToken &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Action 1: Recipient accepts or declines session invite
                         (
                           existing().recipientUid == request.auth.uid &&
                           incoming().status in ['ACCEPTED', 'DECLINED'] &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
                         ) ||
                         // Action 2: Sender cancels/expires session invite
                         (
                           existing().senderUid == request.auth.uid &&
                           incoming().status == 'EXPIRED' &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
                         )
                       );

      allow delete: if isSignedIn() &&
                       isValidId(inviteId) &&
                       (existing().recipientUid == request.auth.uid || existing().senderUid == request.auth.uid);
    }

    // --- 7. Friend Leaderboard Time Alerts (/leaderboardNotifications/{notificationId}) ---
    match /leaderboardNotifications/{notificationId} {
      allow get: if isSignedIn() &&
                    isValidId(notificationId) &&
                    (resource == null || existing().recipientUid == request.auth.uid || existing().senderUid == request.auth.uid);

      allow list: if isSignedIn() &&
                     (existing().recipientUid == request.auth.uid || existing().senderUid == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(notificationId) &&
                       incoming().keys().hasAll([
                         'friendshipId', 'senderUid', 'senderName', 'senderCarType', 'senderColorArgb',
                         'recipientUid', 'gameMode', 'trackKey', 'trackName', 'boardKey',
                         'totalLaps', 'bestRaceTimeMs', 'bestScore', 'dailyChallenge', 'status',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'friendshipId', 'senderUid', 'senderName', 'senderCarType', 'senderColorArgb',
                         'recipientUid', 'gameMode', 'trackKey', 'trackName', 'boardKey',
                         'totalLaps', 'bestRaceTimeMs', 'bestScore', 'dailyChallenge', 'status',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().senderUid == request.auth.uid &&
                       incoming().status == 'UNREAD' &&
                       isValidLeaderboardNotification(incoming()) &&
                       isValidId(incoming().friendshipId) &&
                       exists(/databases/$(database)/documents/friendships/$(incoming().friendshipId)) &&
                       get(/databases/$(database)/documents/friendships/$(incoming().friendshipId)).data.status == 'ACCEPTED' &&
                       incoming().senderUid in get(/databases/$(database)/documents/friendships/$(incoming().friendshipId)).data.memberUids &&
                       incoming().recipientUid in get(/databases/$(database)/documents/friendships/$(incoming().friendshipId)).data.memberUids;

      allow update: if isSignedIn() &&
                       isValidId(notificationId) &&
                       isValidLeaderboardNotification(incoming()) &&
                       existing().status == 'UNREAD' &&
                       existing().recipientUid == request.auth.uid &&
                       incoming().status == 'DISMISSED' &&
                       incoming().friendshipId == existing().friendshipId &&
                       incoming().senderUid == existing().senderUid &&
                       incoming().senderName == existing().senderName &&
                       incoming().senderCarType == existing().senderCarType &&
                       incoming().senderColorArgb == existing().senderColorArgb &&
                       incoming().recipientUid == existing().recipientUid &&
                       incoming().gameMode == existing().gameMode &&
                       incoming().trackKey == existing().trackKey &&
                       incoming().trackName == existing().trackName &&
                       incoming().boardKey == existing().boardKey &&
                       incoming().totalLaps == existing().totalLaps &&
                       incoming().bestRaceTimeMs == existing().bestRaceTimeMs &&
                       incoming().bestScore == existing().bestScore &&
                       incoming().dailyChallenge == existing().dailyChallenge &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isSignedIn() &&
                       isValidId(notificationId) &&
                       (existing().recipientUid == request.auth.uid || existing().senderUid == request.auth.uid);
    }

    // --- 8. Self-Designed Custom Tracks (/customTracks/{trackId}) ---
    match /customTracks/{trackId} {
      allow get: if isSignedIn() &&
                    isValidId(trackId) &&
                    trackId.size() <= 64 &&
                    (resource == null || existing().publicTrack == true || existing().ownerUid == request.auth.uid);

      allow list: if isSignedIn() &&
                     (existing().publicTrack == true || existing().ownerUid == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(trackId) &&
                       trackId.size() <= 64 &&
                       incoming().keys().hasAll([
                         'ownerUid', 'ownerName', 'trackName', 'themeId',
                         'roadHalfWidth', 'payloadData', 'publicTrack',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'ownerUid', 'ownerName', 'trackName', 'themeId',
                         'roadHalfWidth', 'payloadData', 'publicTrack',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().ownerUid == request.auth.uid &&
                       isValidCustomTrack(incoming());

      allow update: if isSignedIn() &&
                       isValidId(trackId) &&
                       trackId.size() <= 64 &&
                       isValidCustomTrack(incoming()) &&
                       existing().ownerUid == request.auth.uid &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'ownerName', 'trackName', 'themeId', 'roadHalfWidth',
                         'payloadData', 'publicTrack', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() &&
                       isValidId(trackId) &&
                       trackId.size() <= 64 &&
                       existing().ownerUid == request.auth.uid;
    }
  }
}

